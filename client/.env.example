# Client configuration. Copy to client/.env (git-ignored; ATAS_ENV_FILE may point elsewhere).

# --- video generation: Wan 3.0 on Alibaba Cloud DashScope
DASHSCOPE_API_KEY=
# WAN30_PRIME_MODEL=wan3.0-video-prime
# WAN30_VIDEO_MODEL=wan3.0-video

# --- or: MiniMax H3 reference-to-video on a ComfyUI server (local weights). The workflow and
#     node map default to comfyui/h3_ref2va_api.json and comfyui/h3_ref2va_node_map.json; to use
#     another API-format export, point these at it and its own node map.
# ATAS_VIDEO_PROVIDER=comfyui        # wan (default) | comfyui
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW=comfyui/h3_ref2va_api.json
# COMFYUI_NODE_MAP=comfyui/h3_ref2va_node_map.json
# COMFYUI_COMFY_ORG_API_KEY=         # hosted partner nodes (H3 Max) only
# COMFYUI_FREE_AFTER_DOWNLOAD=true   # unload models after each clip (shared GPU with geometry)
# COMFYUI_TRIM_TO_SHOT=true          # cut H3's rounded-up length back to the shot duration
# COMFYUI_WIDTH=960                  # with COMFYUI_HEIGHT=544: ~0.5 MP for quick trials (native 1344x768)
# COMFYUI_HEIGHT=544
# COMFYUI_TURBO=true                 # 4-step turbo LoRA instead of 20 full steps

# --- or: everything local on one GPU host. Chat via LM Studio (needs a vision model),
#     stills via Flux.2 Klein image edit on ComfyUI; each service is unloaded before
#     another one uses the GPU.
# ATAS_CHAT_URL=http://127.0.0.1:1234/v1       # chat-completions endpoint; overrides ATAS_LLM_URL
# ATAS_LLM_MODEL=gemma-4-31b-it-uncensored-heretic
# ATAS_LMSTUDIO_URL=http://127.0.0.1:1234       # enables unloading LM Studio before GPU stages
# ATAS_CHAT_TIMEOUT_SECONDS=900                # per-call limit for the local model (multi-image prompts are slow)
# ATAS_IMAGE_BACKEND=comfyui
# COMFYUI_IMAGE_UNET=flux-2-klein-9b.safetensors

# --- language/vision model and gpt-image (planning, camera grounding, prompt authoring,
#     film review, identity references, opening stills). Any OpenAI-compatible gateway.
ATAS_LLM_URL=https://api.openai.com/v1/responses
ATAS_LLM_API_KEY=
ATAS_LLM_MODEL=gpt-5.1
# ATAS_LLM_SERVICE_TIER=         # optional Responses service_tier
# ATAS_IMAGE_BACKEND=auto        # auto | images_api | responses_tool (gateways without /images)
# AVWM_IMAGE_BASE_URL=           # images API base when it differs from the Responses gateway
# AVWM_IMAGE_API_KEY=
# ATAS_LLM_STREAM=1              # stream responses (avoids proxy timeouts on long calls)

# --- geometry service (geometry/), reachable from this machine
GEOMETRY_SERVICE_URL=http://127.0.0.1:18300
GEOMETRY_API_TOKEN=

# --- pipeline budgets
# ATAS_FILM_REPAIRS=2            # regenerations after a failed film review
# ATAS_CAMERA_REPLANS=3          # camera re-plans when a memory render is unusable
# ATAS_EVENT_SOURCE_RETRIES=1    # retakes of a recapture source that was not admitted
# ATAS_OPERATIONAL_ATTEMPTS=3    # retries of a shot on transient provider/service errors
